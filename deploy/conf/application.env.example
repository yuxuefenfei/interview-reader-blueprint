# 生产配置模板；实际文件位于 /opt/ireader/conf/application.env。
# 以下空值必须在服务器上填写。不要把真实配置提交到仓库。

DATABASE_URL=''
DATABASE_USERNAME=''
DATABASE_PASSWORD=''

INTERVIEW_READER_USERNAME=''
INTERVIEW_READER_PASSWORD=''
INTERVIEW_READER_ALLOWED_ORIGINS=''

INTERVIEW_READER_STORAGE_DIR='/opt/ireader/data'

HTTP_PORT='28080'
JAVA_BIN='/usr/local/jdk/default/bin/java'

JAVA_OPTS='-Djava.awt.headless=true -Dfile.encoding=UTF-8 -XX:MaxRAMPercentage=75'

EXTRA_APP_OPTS=''

# 独立升级控制台与主应用共用的维护门禁和本机接口令牌。
UPGRADE_MAINTENANCE_FILE='/opt/ireader/tmp/upgrade.maintenance'
UPGRADE_INTERNAL_TOKEN=''
