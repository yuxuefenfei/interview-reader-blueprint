{
  "name": "interview-reader-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "api:generate": "openapi-ts",
    "build": "npm run api:generate && vue-tsc --noEmit && vite build && node scripts/check-bundle-budget.mjs",
    "lint": "eslint .",
