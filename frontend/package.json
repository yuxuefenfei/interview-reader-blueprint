    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "contract:check": "node scripts/check-api-contract.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "axios": "1.18.1",
    "element-plus": "2.14.3",
    "highlight.js": "11.11.1",
    "katex": "0.16.22",
    "vue": "3.5.39",
    "vue-router": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vue/test-utils": "2.4.11",
    "@vitejs/plugin-vue": "6.0.7",
    "eslint": "10.0.1",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.8.0",
    "jsdom": "29.1.1",
    "@hey-api/openapi-ts": "0.99.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.6",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.11.0"
